erDiagram
    QUESTIONS ||--o| ANSWERS : "produces"
    ANSWERS ||--o{ CITATIONS : "cites"
    KNOWLEDGE_SOURCES ||--o{ CITATIONS : "is referenced by"
    ANSWERS ||--o{ ANSWER_FEEDBACK : "receives"

    QUESTIONS {
        TEXT id PK
        TEXT course_id
        TEXT student_id
        TEXT question_text
        TEXT status
        TEXT created_at
        TEXT updated_at
    }

    ANSWERS {
        TEXT id PK
        TEXT question_id FK
        TEXT content
        TEXT mode
        INTEGER no_source_found
        TEXT created_at
    }

    CITATIONS {
        TEXT id PK
        TEXT answer_id FK
        TEXT source_id FK
        TEXT excerpt
        TEXT location
        REAL score
        TEXT created_at
    }

    KNOWLEDGE_SOURCES {
        TEXT id PK
        TEXT course_id
        TEXT title
        TEXT source_type
        TEXT source_url
        TEXT storage_key
        TEXT content
        TEXT keywords
        TEXT status
        TEXT created_by
        TEXT created_at
        TEXT updated_at
    }

    ANSWER_FEEDBACK {
        TEXT id PK
        TEXT answer_id FK
        TEXT user_id
        INTEGER rating
        TEXT comment
        TEXT created_at
    }

    RECEIVED_EVENTS {
        TEXT event_id PK
        TEXT event_type
        TEXT source
        TEXT occurred_at
        TEXT received_at
        TEXT payload_json
        TEXT processing_status
    }
