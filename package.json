{
  "name": "learning-assistant-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --env local",
    "db:migrate:local": "wrangler d1 migrations apply learning-assistant-db --local --env local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:khant": "wrangler deploy --env khant",
    "db:migrate:khant": "wrangler d1 migrations apply learning-assistant-db --remote --env khant"
  },
  "dependencies": {
    "hono": "^4.6.9"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "wrangler": "^4.0.0"
  }
}
