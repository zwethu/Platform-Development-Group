# Security headers for the static UI (Cloudflare Workers static assets).
# CSP: only this origin may supply scripts, styles and images; API calls may
# go to this origin and to Student Identity (Team 01) for sign-in —
# no inline scripts, no third-party code, no framing (clickjacking).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://student-identity.onrender.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
